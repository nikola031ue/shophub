{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "CHANGE-THIS-IN-PRODUCTION-MIN-32-CHARS!!",
    "Issuer": "ShopHubApi",
    "Audience": "ShopHubClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "Origins": []
  },
  "Kubernetes": {
    "Enabled": true,
    "NamespacePrefix": "shops",
    "Group": "shop.shophub.io",
    "Version": "v1alpha1",
    "Plural": "shops",
    "Cnpg": {
      "Group": "postgresql.cnpg.io",
      "Version": "v1",
      "Plural": "clusters",
      "StorageSize": "1Gi",
      "Instances": 1
    },
    "Redb": {
      "Group": "app.redislabs.com",
      "Version": "v1alpha1",
      "Plural": "redisenterprisedatabases",
      "MemorySize": "100MB"
    }
  }
}
